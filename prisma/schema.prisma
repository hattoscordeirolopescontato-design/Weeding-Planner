// Schema do Wedding Planner (plataforma multi-casais)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Usuários e casamentos
// ---------------------------------------------------------------------------

// Um usuário é um(a) noivo(a). Faz login na área administrativa.
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String // hash bcrypt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships WeddingMember[]
  vows        Vow[]
}

// Um casamento é o "tenant". Pertence a um ou dois noivos (via WeddingMember).
model Wedding {
  id        String    @id @default(cuid())
  title     String // ex: "Casamento de Ana & João"
  date      DateTime? // data do casamento (opcional no início)
  budget    Float? // orçamento total previsto
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members WeddingMember[]
  vendors Vendor[]
  venues  Venue[]
  guests  Guest[]
  vows    Vow[]
}

// Relação N:N entre usuários e casamentos (permite os dois noivos no mesmo).
model WeddingMember {
  id        String   @id @default(cuid())
  role      String   @default("owner") // owner | partner
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([userId, weddingId])
  @@index([weddingId])
}

// ---------------------------------------------------------------------------
// Funcionalidades de planejamento
// ---------------------------------------------------------------------------

// Fornecedores (buffet, fotografia, decoração, música, etc.)
model Vendor {
  id        String   @id @default(cuid())
  name      String
  category  String // ex: "Buffet", "Fotografia", "Decoração"
  contact   String? // telefone / e-mail / contato
  price     Float? // valor contratado/orçado
  status    String   @default("cotacao") // cotacao | contratado | pago | cancelado
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

// Locais (cerimônia / festa). Permite comparar opções; um pode ser o escolhido.
model Venue {
  id         String   @id @default(cuid())
  name       String
  address    String?
  capacity   Int? // capacidade de convidados
  price      Float?
  isSelected Boolean  @default(false) // local escolhido
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

// Convidados
model Guest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  groupName String? // ex: "Família da noiva", "Amigos do trabalho"
  rsvp      String   @default("pendente") // pendente | confirmado | recusado
  plusOnes  Int      @default(0) // acompanhantes
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

// Votos: conteúdo criptografado em repouso (AES-256-GCM) com senha própria.
// Nem o acesso ao banco revela o texto sem a senha.
model Vow {
  id         String   @id @default(cuid())
  title      String   @default("Meus votos")
  ciphertext String // texto cifrado (base64)
  iv         String // vetor de inicialização (base64)
  salt       String // salt da derivação de chave (base64)
  authTag    String // tag de autenticação GCM (base64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([authorId])
}
